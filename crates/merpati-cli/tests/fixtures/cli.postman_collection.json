{
  "info": {
    "_postman_id": "c11c11c1-0000-4000-8000-000000000001",
    "name": "CLI Fixture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": ["pm.variables.set('client', 'merpati-cli');"] }
    }
  ],
  "variable": [{ "key": "apiVersion", "value": "v1", "type": "string" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('token matches user', () => {",
                  "    pm.expect(body.token).to.equal('tok-' + pm.variables.get('user'));",
                  "});",
                  "pm.environment.set('token', body.token);",
                  "console.log('logged in as', pm.variables.get('user'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Client", "value": "{{client}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\"user\": \"{{user}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/{{apiVersion}}/login", "host": ["{{baseUrl}}"], "path": ["{{apiVersion}}", "login"] }
          },
          "response": [
            {
              "name": "Logged in",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": { "raw": "{{baseUrl}}/v1/login", "host": ["{{baseUrl}}"], "path": ["v1", "login"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"token\": \"example-token\"}"
            }
          ]
        },
        {
          "name": "Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('authorized', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('profile of current user', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('user', pm.variables.get('user'));",
                  "    pm.expect(json.client).to.equal('merpati-cli');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Client", "value": "{{client}}" }],
            "url": { "raw": "{{baseUrl}}/{{apiVersion}}/me", "host": ["{{baseUrl}}"], "path": ["{{apiVersion}}", "me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Broken",
      "item": [
        {
          "name": "Missing page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('page exists', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/missing", "host": ["{{baseUrl}}"], "path": ["missing"] }
          },
          "response": []
        }
      ]
    }
  ]
}
