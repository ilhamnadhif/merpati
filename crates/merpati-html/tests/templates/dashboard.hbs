<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; margin: 0; padding: 16px; background: #f4f6f8; color: #1f2933; }
  h2 { margin: 0 0 12px; font-size: 18px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .kpi { position: relative; background: #fff; border: 1px solid #e3e8ee; border-radius: 8px; padding: 12px 16px; }
  .kpi .label { font-size: 12px; text-transform: uppercase; color: #616e7c; }
  .kpi .value { font-size: 28px; font-weight: 700; margin-top: 4px; }
  .kpi .trend { position: absolute; top: 10px; right: 10px; font-size: 11px; padding: 2px 6px; border-radius: 10px; }
  .up { background: #e3f9e5; color: #1f7a45; }
  .down { background: #fde8e8; color: #b91c1c; }
  .layout { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; align-items: start; }
  .panel { background: #fff; border: 1px solid #e3e8ee; border-radius: 8px; padding: 12px; }
  .panel h3 { margin: 0 0 8px; font-size: 14px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eef1f4; }
  th { position: sticky; top: 0; background: #fafbfc; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  .ok { background: #31c48d; }
  .fail { background: #f05252; }
  .row { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 2px; }
  .bar { height: 8px; background: #e4e7eb; border-radius: 4px; overflow: hidden; margin-bottom: 10px; }
  .bar > div { height: 100%; background: #3f83f8; }
  @media (max-width: 600px) { .layout { grid-template-columns: 1fr; } }
</style>
<h2>{{title}}</h2>
<div class="kpis">
  {{#each kpis}}
  <div class="kpi"><div class="label">{{label}}</div><div class="value">{{value}}</div>
    <span class="trend {{#if up}}up{{else}}down{{/if}}">{{delta}}</span></div>
  {{/each}}
</div>
<div class="layout">
  <div class="panel">
    <h3>Requests</h3>
    <table>
      <thead><tr><th>Endpoint</th><th>Status</th><th>Latency</th></tr></thead>
      <tbody>
      {{#each requests}}
        <tr><td>{{path}}</td><td><span class="dot {{#if ok}}ok{{else}}fail{{/if}}"></span>{{code}}</td><td>{{ms}} ms</td></tr>
      {{/each}}
      </tbody>
    </table>
  </div>
  <div class="panel">
    <h3>Latency budget</h3>
    {{#each budgets}}
      <div class="row"><span>{{name}}</span><span>{{pct}}%</span></div>
      <div class="bar"><div style="width: {{pct}}%"></div></div>
    {{/each}}
  </div>
</div>
