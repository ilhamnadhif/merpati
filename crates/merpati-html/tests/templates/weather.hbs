<style>
  body { font-family: Helvetica, Arial, sans-serif; margin: 12px; }
  .hero { position: relative; height: 160px; border-radius: 10px; background: linear-gradient(#4a90e2, #2c6cb0); color: #fff; }
  .now { position: absolute; left: 16px; bottom: 14px; }
  .now .temp { font-size: 48px; font-weight: bold; line-height: 1; }
  .cond { position: absolute; right: 16px; top: 14px; text-align: right; }
  .alert { position: absolute; left: 50%; top: 14px; width: 140px; margin-left: -70px; background: #f39c12; color: #fff; text-align: center; border-radius: 12px; font-size: 12px; z-index: 2; }
  .days { display: flex; gap: 8px; margin-top: 12px; }
  .day { flex: 1; text-align: center; padding: 8px; background: #f0f4f8; border-radius: 6px; }
  .day .hi { font-weight: bold; }
  pre { max-height: 90px; overflow: auto; background: #272822; color: #f8f8f2; padding: 8px; font-size: 12px; }
</style>
<div class="hero">
  {{#if alert}}<div class="alert">{{alert}}</div>{{/if}}
  <div class="cond">{{condition}}<br><small>wind {{wind}} km/h</small></div>
  <div class="now"><div class="temp">{{temp}}°</div><div>{{city}}</div></div>
</div>
<div class="days">
  {{#each forecast}}<div class="day"><div>{{day}}</div><span class="hi">{{hi}}°</span> / {{lo}}°</div>{{/each}}
</div>
<h4>Raw response</h4>
<pre>{{json}}</pre>
