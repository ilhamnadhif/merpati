<style>
  body { font-family: Arial, sans-serif; margin: 12px; }
  .clearfix::after { content: ""; display: table; clear: both; }
  .card { box-sizing: border-box; float: left; width: 31%; margin: 0 1% 12px; border: 1px solid #ddd; border-radius: 4px; padding: 8px; overflow: hidden; position: relative; }
  .card img { float: left; margin-right: 8px; border-radius: 50%; }
  .card .name { font-weight: bold; }
  .card .mail { color: #666; font-size: 12px; }
  .ribbon { position: absolute; top: 6px; right: -22px; width: 80px; text-align: center; background: #e67e22; color: #fff; font-size: 10px; }
  .footer { clear: both; text-align: center; color: #888; border-top: 1px solid #eee; padding-top: 6px; }
  .note { float: right; width: 180px; margin: 0 0 8px 12px; padding: 6px; background: #fffbe6; border: 1px solid #f5d76e; font-size: 12px; }
</style>
<p class="intro"><span class="note">Profiles come from <code>GET /users</code>; admins are marked.</span>
{{users.length}} people signed up this week. Each card shows the avatar, the name and the e-mail address of a user,
laid out with floats the way older templates often do.</p>
<div class="clearfix">
  {{#each users}}
  <div class="card">
    {{#if admin}}<div class="ribbon">ADMIN</div>{{/if}}
    <img src="{{avatar}}" width="40" height="40" alt="{{initials}}">
    <div class="name">{{name}}</div>
    <div class="mail">{{email}}</div>
  </div>
  {{/each}}
</div>
<div class="footer">{{users.length}} users</div>
